<%- include("partials/layout-open", { pageTitle: "HR Applications Queue", activePortal: "hr" }) %>
<main class="container wide">
      <section class="card">
        <div class="row-between">
          <h1>HR Applications Queue</h1>
          <div class="actions tight">
            <% if (currentAdminRole === 'developer') { %>
              <a class="btn primary" href="/hr/developer-console">Developer Console</a>
              <a class="btn secondary" href="/hr/periods">Period and Slot Settings</a>
              <a class="btn secondary" href="/hr/admin-accounts">Admin Accounts</a>
            <% } else { %>
              <a class="btn secondary" href="/hr/departments">Department Status</a>
              <a class="btn secondary" href="/hr/communications">Communications</a>
              <a class="btn secondary" href="/hr/supervisors">Supervisors</a>
              <a class="btn secondary" href="/hr/audit">Audit Trail</a>
              <a class="btn secondary" href="/hr/reports">Reports</a>
              <a class="btn secondary" href="/hr/admin-accounts">Admin Accounts</a>
            <% } %>
            <form action="/hr/logout" method="post">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
              <button class="btn secondary" type="submit">Logout</button>
            </form>
          </div>
        </div>

        <div class="stats compact">
          <div>
            <strong><%= stats.total %></strong>
            <span>Total</span>
          </div>
          <div>
            <strong><%= stats.verified %></strong>
            <span>Verified</span>
          </div>
          <div>
            <strong><%= stats.approved %></strong>
            <span>Admitted</span>
          </div>
          <div>
            <strong><%= stats.rejected %></strong>
            <span>Rejected</span>
          </div>
        </div>

        <form method="get" action="/hr/applications" class="filter-row">
          <label>
            Filter by status
            <select name="status">
              <option value="Verified" <%= statusFilter === 'Verified' ? 'selected' : '' %>>Verified</option>
              <option value="Admitted" <%= statusFilter === 'Admitted' ? 'selected' : '' %>>Admitted</option>
              <option value="Rejected" <%= statusFilter === 'Rejected' ? 'selected' : '' %>>Rejected</option>
              <option value="All" <%= statusFilter === 'All' ? 'selected' : '' %>>All</option>
            </select>
          </label>
          <label>
            Filter by department
            <select name="department">
              <option value="All" <%= departmentFilter === 'All' ? 'selected' : '' %>>All departments</option>
              <% departmentOptions.forEach((department) => { %>
                <option value="<%= department.key %>" <%= departmentFilter === department.key ? 'selected' : '' %>>
                  <%= department.label %>
                </option>
              <% }) %>
            </select>
          </label>
          <label>
            Search
            <input type="text" name="search" value="<%= search || '' %>" placeholder="Tracking number, name, email, ID" />
          </label>
          <label>
            Submitted from
            <input type="date" name="dateFrom" value="<%= dateFrom || '' %>" />
          </label>
          <label>
            Submitted to
            <input type="date" name="dateTo" value="<%= dateTo || '' %>" />
          </label>
          <div class="actions">
            <button class="btn" type="submit">Apply</button>
            <a class="btn secondary" href="/hr/applications">Reset</a>
          </div>
        </form>

        <div class="table-container">
          <table class="table">
            <thead>
              <tr>
                <th>Applicant</th>
                <th>Course Details</th>
                <th>Period</th>
                <th>Status</th>
                <th class="table-action-cell">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% if (!applications.length) { %>
                <tr>
                  <td colspan="5" class="table-empty-cell">No matching applications found.</td>
                </tr>
              <% } else { %>
                <% applications.forEach((application) => { %>
                  <tr>
                    <td>
                      <div class="applicant-cell">
                        <strong><%= application.fullName %></strong>
                        <span>ID: <%= application.idNumber %></span>
                        <span><%= application.email %></span>
                        <span><%= application.phone %></span>
                      </div>
                    </td>
                    <td>
                      <div class="course-cell">
                        <strong><%= application.course %></strong>
                        <span><%= getCourseLevelLabel(application.courseLevel) %></span>
                        <span><%= getDepartmentLabel(application.appliedDepartment) %></span>
                      </div>
                    </td>
                    <td>
                      <div class="period-cell">
                        <strong><%= application.period %></strong>
                        <span><%= formatDate(application.startDate) %> to <%= formatDate(application.endDate) %></span>
                      </div>
                    </td>
                    <td>
                      <div class="status-cell-wrap" style="display: flex; flex-direction: column; gap: 0.4rem; align-items: flex-start;">
                        <span class="status-badge <%= getStatusClass(application.status) %>">
                          <%= application.status %>
                        </span>
                        <% if (application.status === 'Admitted' || application.status === 'Verified') { %>
                          <% const nitaStatus = application.nitaWorkflow?.status || 'Pending County Signature' %>
                          <span class="badge <%= getNitaStatusClass(nitaStatus) %>" style="font-size: 0.72rem; padding: 0.15rem 0.45rem;">
                            NITA: <%= nitaStatus %>
                          </span>
                        <% } %>
                      </div>
                    </td>
                    <td class="table-action-cell">
                      <a class="btn small" href="/hr/applications/<%= application.id %>">View Details</a>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </section>

      <section class="card margin-top">
        <h2>Department Slot Status</h2>
        <div class="table-container">
          <table class="table">
            <thead>
              <tr>
                <th>Department</th>
                <th class="table-count-cell">Capacity</th>
                <th class="table-count-cell">Applications</th>
                <th class="table-count-cell">Verified</th>
                <th class="table-count-cell">Admitted</th>
                <th class="table-count-cell">Pending</th>
                <th class="table-count-cell">Remaining</th>
                <th class="table-action-cell">Actions</th>
              </tr>
            </thead>
            <tbody>
              <% departmentSummaries.forEach((department) => { %>
                <tr>
                  <td>
                    <%= department.label %>
                  </td>
                  <td class="table-count-cell"><%= department.capacity %></td>
                  <td class="table-count-cell"><%= department.applications %></td>
                  <td class="table-count-cell"><%= department.verified %></td>
                  <td class="table-count-cell"><%= department.approved %></td>
                  <td class="table-count-cell"><%= department.pending %></td>
                  <td class="table-count-cell"><%= department.remaining %></td>
                  <td class="table-action-cell">
                    <div class="table-actions">
                      <a href="/hr/reports/export.csv?status=All&period=All&department=<%= department.key %>">Export</a>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </section>
    </main>
<%- include("partials/layout-close") %>

