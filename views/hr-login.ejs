<%- include("partials/layout-open", { pageTitle: "Administrative Login", activePortal: "hr" }) %>
<main class="container small">
      <section class="card">
        <h1>Administrative Portal</h1>
        <p>
          Access county administrator and review systems. Select your appropriate role and credentials to proceed.
        </p>

        <% if (error) { %>
          <div class="alert"><%= error %></div>
        <% } %>

        <form id="authForm" action="<%= hrPortalPath %>" method="post" class="form-grid auth-form">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          
          <label>
            Administrative Role
            <select id="authRoleSelect" name="role" required>
              <option value="hr_admin" <%= defaultRole === "hr_admin" ? "selected" : "" %>>Main HR Administrator</option>
              <option value="department_admin" <%= defaultRole === "department_admin" ? "selected" : "" %>>Departmental HR / Admin</option>
              <option value="developer" <%= defaultRole === "developer" ? "selected" : "" %>>Developer / System Admin</option>
            </select>
          </label>

          <div id="departmentFieldGroup" style="display: none;">
            <label>
              Department Scope
              <select id="authDeptSelect" name="department">
                <option value="" disabled selected>-- Select your Department --</option>
                <% departmentsList.forEach(dept => { %>
                  <option value="<%= dept.key %>"><%= dept.label %></option>
                <% }) %>
              </select>
            </label>
          </div>

          <label>
            Username
            <input type="text" name="username" required autocomplete="username" />
          </label>

          <label>
            Password
            <input type="password" name="password" required autocomplete="current-password" />
          </label>

          <div class="actions">
            <button class="btn" type="submit">Login</button>
            <a class="btn secondary" href="/">Back</a>
          </div>
        </form>
      </section>
    </main>

    <script>
      document.addEventListener('DOMContentLoaded', () => {
        const roleSelect = document.getElementById('authRoleSelect');
        const deptGroup = document.getElementById('departmentFieldGroup');
        const deptSelect = document.getElementById('authDeptSelect');
        const authForm = document.getElementById('authForm');
        const hrPath = '<%= hrPortalPath %>';
        const staffPath = '<%= adminPortalPath %>';

        function syncFormState() {
          const selectedRole = roleSelect.value;
          if (selectedRole === 'department_admin') {
            deptGroup.style.display = 'block';
            deptSelect.required = true;
            authForm.action = staffPath;
          } else {
            deptGroup.style.display = 'none';
            deptSelect.required = false;
            deptSelect.value = '';
            authForm.action = hrPath;
          }
        }

        roleSelect.addEventListener('change', syncFormState);
        syncFormState(); // Initial check
      });
    </script>
<%- include("partials/layout-close") %>

